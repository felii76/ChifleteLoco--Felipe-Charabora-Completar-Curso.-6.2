        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ----- ENTIDADES (Rectángulos) -----\n    CLI[CLIENTES]\n    PED[PEDIDOS]\n    FAC[FACTURAS]\n    PRO[PRODUCTOS]\n    MAT[MATERIAS_PRIMAS]\n    MOVS[MOVIMIENTOS_STOCK]\n    MOVM[MOVIMIENTOS_STOCK_MATERIAS]\n\n    %% ----- RELACIONES (Rombos) -----\n    R1{Realiza}\n    R2{Genera}\n    R3{Se compone}\n    R4{Registra_P}\n    R5{Registra_M}\n\n    %% ----- CONEXIONES Y CARDINALIDADES -----\n    CLI ---|1| R1 ---|N| PED\n    PED ---|1| R2 ---|1| FAC\n    PED ---|N| R3 ---|M| PRO\n    PRO ---|1| R4 ---|N| MOVS\n    MAT ---|1| R5 ---|N| MOVM\n\n    %% ----- ATRIBUTOS PRINCIPALES (Óvalos) -----\n    %% Clientes\n    c_id([_id_cliente_])\n    c_nom([nombre])\n    c_ape([apellido])\n    CLI --- c_id &amp; c_nom &amp; c_ape\n\n    %% Pedidos\n    p_id([_id_pedido_])\n    p_fec([fecha])\n    p_est([estado])\n    PED --- p_id &amp; p_fec &amp; p_est\n\n    %% Facturas\n    f_id([_id_factura_])\n    f_tot([total])\n    FAC --- f_id &amp; f_tot\n\n    %% Atributos de la Relación Detalle_Pedido (Se compone)\n    det_cant([cantidad])\n    det_pre([precio_unitario])\n    R3 --- det_cant &amp; det_pre\n\n    %% Productos\n    pr_id([_id_producto_])\n    pr_nom([nombre])\n    pr_stk([stock])\n    PRO --- pr_id &amp; pr_nom &amp; pr_stk\n\n    %% Materias Primas\n    mp_id([_id_materia_prima_])\n    mp_nom([nombre])\n    mp_stk([stock])\n    MAT --- mp_id &amp; mp_nom &amp; mp_stk\n\n    %% Movimientos (Stock y Materias)\n    ms_id([_id_movimiento_])\n    ms_cant([cantidad])\n    MOVS --- ms_id &amp; ms_cant\n    \n    msm_id([_id_movimiento_])\n    msm_cant([cantidad])\n    MOVM --- msm_id &amp; msm_cant&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JgAjtdv-QSUiyE0gajOR-65">
